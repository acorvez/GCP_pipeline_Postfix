-- Create user with restricted permissions for Postfix access
CREATE USER postfix_user WITH PASSWORD 'postfix_password';
GRANT SELECT ON domains, users, aliases TO postfix_user;

-- Create view for mail delivery
CREATE VIEW mail_delivery AS 
SELECT u.email, 'maildir:/var/mail/' || u.email || '/' AS destination 
FROM users u 
WHERE u.active = true;

GRANT SELECT ON mail_delivery TO postfix_user;
