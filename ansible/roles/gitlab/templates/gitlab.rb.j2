external_url 'http://gitlab.example.com'
letsencrypt['enable'] = false

# Configuration des répertoires de données
git_data_dirs({
  "default" => {
    "path" => "/opt/gitlab-data/git-data"
  }
})

# Configuration PostgreSQL
postgresql['data_dir'] = "/opt/gitlab-data/postgresql"

# Configuration Rails
gitlab_rails['uploads_directory'] = "/opt/gitlab-data/gitlab-rails/uploads"
gitlab_rails['shared_path'] = "/opt/gitlab-data/gitlab-rails/shared"
gitlab_rails['backup_path'] = "/opt/gitlab-data/gitlab-rails/backups"

# Prometheus (pas Grafana)
prometheus['enable'] = true

# Configuration des sauvegardes
gitlab_rails['backup_keep_time'] = 604800
