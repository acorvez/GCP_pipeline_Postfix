---
# Playbook corrigé pour configurer l'intégration entre GitLab et Jenkins

# Partie 1: Configuration de GitLab
- hosts: gitlab_servers
  become: true
  tasks:
    - name: Wait for GitLab to be fully operational
      uri:
        url: http://127.0.0.1
        status_code: [200, 302]
        timeout: 5
      register: gitlab_status
      until: gitlab_status.status == 200 or gitlab_status.status == 302
      retries: 30
      delay: 10
      ignore_errors: yes
      
    - name: Get GitLab root password
      shell: |
        if [ -f /etc/gitlab/initial_root_password ]; then
          cat /etc/gitlab/initial_root_password | grep Password | awk '{print $2}'
        else
          echo "{{ gitlab_root_password | default('gitlabadmin123') }}"
        fi
      register: gitlab_root_pass
      changed_when: false
      
    - name: Create personal access token
      shell: |
        curl --request POST \
          --header "Content-Type: application/json" \
          --data '{"name":"jenkins-token","scopes":["api","read_repository","write_repository"]}' \
          --user "root:{{ gitlab_root_pass.stdout }}" \
          http://127.0.0.1/api/v4/personal_access_tokens
      register: gitlab_token_response
      changed_when: false
      ignore_errors: true
      
    - name: Save token to a file
      copy:
        content: "token_placeholder"
        dest: /tmp/gitlab_token
        mode: 0644
      
    - name: Create postfix-config project
      shell: |
        curl --request POST \
          --header "Content-Type: application/json" \
          --data '{"name":"postfix-config","description":"Configuration Postfix pour notre infrastructure","visibility":"private"}' \
          --user "root:{{ gitlab_root_pass.stdout }}" \
          http://127.0.0.1/api/v4/projects
      ignore_errors: true

# Partie 2: Configuration de Jenkins
- hosts: jenkins_servers
  become: true
  tasks:
    - name: Wait for Jenkins to be fully operational
      uri:
        url: http://localhost:8080
        status_code: [200, 403]
        timeout: 5
      register: jenkins_status
      until: jenkins_status.status == 200 or jenkins_status.status == 403
      retries: 30
      delay: 10
      ignore_errors: yes
      
    - name: Get Jenkins initial admin password
      shell: cat /var/lib/jenkins/secrets/initialAdminPassword || echo "jenkinsadmin123"
      register: jenkins_password
      changed_when: false
      ignore_errors: yes
      
    - name: Check if jenkins-cli.jar exists
      stat:
        path: /var/lib/jenkins/jenkins-cli.jar
      register: jenkins_cli_stat
      
    - name: Download jenkins-cli.jar if needed
      get_url:
        url: http://localhost:8080/jnlpJars/jenkins-cli.jar
        dest: /var/lib/jenkins/jenkins-cli.jar
        mode: '0644'
      when: not jenkins_cli_stat.stat.exists
      ignore_errors: yes
      
    - name: Create Jenkinsfile in project
      copy:
        content: |
          pipeline {
              agent any
              
              stages {
                  stage('Test') {
                      steps {
                          echo 'Testing Postfix configuration'
                      }
                  }
                  
                  stage('Deploy') {
                      steps {
                          echo 'Deploying Postfix configuration'
                      }
                  }
              }
          }
        dest: /tmp/Jenkinsfile
        mode: '0644'
      
    - name: Install required Jenkins plugins
      shell: |
        java -jar /var/lib/jenkins/jenkins-cli.jar -s http://localhost:8080 -auth admin:{{ jenkins_password.stdout }} install-plugin {{ item }} -deploy
      with_items:
        - git
        - workflow-aggregator
        - pipeline-stage-view
        - gitlab-plugin
      ignore_errors: true
      
    - name: Create simple pipeline job
      shell: |
        cat > /tmp/job.xml << 'EOF'
        <?xml version='1.1' encoding='UTF-8'?>
        <flow-definition plugin="workflow-job">
          <description>Pipeline pour le déploiement de Postfix</description>
          <keepDependencies>false</keepDependencies>
          <definition class="org.jenkinsci.plugins.workflow.cps.CpsFlowDefinition" plugin="workflow-cps">
            <script>
        pipeline {
            agent any
            
            stages {
                stage('Test') {
                    steps {
                        echo 'Testing Postfix configuration'
                    }
                }
                
                stage('Deploy') {
                    steps {
                        echo 'Deploying Postfix configuration'
                    }
                }
            }
        }
            </script>
            <sandbox>true</sandbox>
          </definition>
          <triggers/>
        </flow-definition>
        EOF

        curl -X POST 'http://localhost:8080/createItem?name=postfix-deployment' \
          -u admin:{{ jenkins_password.stdout }} \
          --data-binary @/tmp/job.xml \
          -H "Content-Type:text/xml"
      ignore_errors: true
