api:
  dashboard: true
  insecure: true  # À supprimer en production

entryPoints:
  web:
    address: ":80"
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: ":443"

providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false

certificatesResolvers:
  myresolver:
    acme:
      email: {{ admin_email | default('your-email@example.com') }}
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web
