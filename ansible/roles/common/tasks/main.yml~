---
- name: Clean up any broken Docker repositories
  shell: |
    rm -f /etc/apt/sources.list.d/docker*.list
    rm -f /usr/share/keyrings/docker*.gpg
    rm -f /etc/apt/keyrings/docker*.gpg
    apt-get clean
    apt-get update
  args:
    executable: /bin/bash
  ignore_errors: yes
  when: ansible_distribution == 'Debian'

# Installation des packages de base
- name: Install common packages
  apt:
    name:
      - fail2ban
      - ufw
      - curl
      - wget
      - vim
      - htop
      - net-tools
      - python3-pip
      - python3-apt
      - unzip
      - git
      - ca-certificates
      - gnupg
      - lsb-release
    state: present
    update_cache: yes

# Configuration de fail2ban
- name: Configure fail2ban
  template:
    src: jail.local.j2
    dest: /etc/fail2ban/jail.local
    owner: root
    group: root
    mode: 0644
  notify: restart fail2ban

# Configuration du firewall UFW
- name: Configure UFW defaults
  ufw:
    direction: "{{ item.direction }}"
    policy: "{{ item.policy }}"
  with_items:
    - { direction: 'incoming', policy: 'deny' }
    - { direction: 'outgoing', policy: 'allow' }

# Vérification et préparation des disques
- name: Check if additional disk exists
  stat:
    path: /dev/sdb
  register: disk_exists

- name: Create necessary data directories
  file:
    path: "{{ item }}"
    state: directory
    mode: 0755
  with_items:
    - /var/lib/docker/volumes
    - /mnt/gitlab-data
    - /mnt/monitoring-data
    - /opt/gitlab-data
    - /opt/monitoring-data
    - /opt/postfix
  when: not disk_exists.stat.exists

# Configuration du disque additionnel si présent
- name: Format and mount additional disk if it exists
  block:
    - name: Check if filesystem exists on disk
      command: blkid -p /dev/sdb
      register: blkid_result
      failed_when: false
      changed_when: false

    - name: Create filesystem on additional disk
      command: mkfs.ext4 /dev/sdb
      when: blkid_result.rc != 0

    - name: Create mount points
      file:
        path: "{{ item }}"
        state: directory
        mode: 0755
      with_items:
        - /mnt/gitlab-data
        - /mnt/monitoring-data
        - /opt/gitlab-data
        - /opt/monitoring-data
        - /opt/postfix

    - name: Add mount to fstab and mount
      mount:
        path: /mnt/data
        src: /dev/sdb
        fstype: ext4
        opts: defaults
        state: mounted

    - name: Create symlinks from /mnt/data to specific directories
      file:
        src: /mnt/data/{{ item.subdir }}
        path: "{{ item.path }}"
        state: link
        force: yes
      with_items:
        - { subdir: 'gitlab', path: '/opt/gitlab-data' }
        - { subdir: 'monitoring', path: '/opt/monitoring-data' }
        - { subdir: 'postfix', path: '/opt/postfix' }
      when: disk_exists.stat.exists
  when: disk_exists.stat.exists

# Paramétrage du hostname
- name: Set hostname
  hostname:
    name: "{{ inventory_hostname }}"

# Configuration du swap
- name: Check if swap file exists
  stat:
    path: /swapfile
  register: swap_file_check

- name: Create swap file if it doesn't exist
  command: dd if=/dev/zero of=/swapfile bs=1M count=2048
  when: not swap_file_check.stat.exists

- name: Set permissions on swap file
  file:
    path: /swapfile
    mode: 0600
  when: not swap_file_check.stat.exists

- name: Make swap file
  command: mkswap /swapfile
  when: not swap_file_check.stat.exists

- name: Enable swap file
  command: swapon /swapfile
  when: not swap_file_check.stat.exists and ansible_swaptotal_mb < 1

- name: Add swap to fstab
  lineinfile:
    path: /etc/fstab
    line: "/swapfile none swap sw 0 0"
    state: present
  when: not swap_file_check.stat.exists
